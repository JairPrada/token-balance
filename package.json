{
  "name": "@openplugins/token-balance",
  "version": "1.0.0",
  "description": "OpenCode sidebar plugin: DeepSeek, OpenCode Go and OpenCode Zen balance",
  "type": "module",
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "tui"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "token",
    "balance",
    "quota",
    "deepseek",
    "openai",
    "zen",
    "sidebar",
    "tui"
  ],
  "author": "Jair Prada",
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
